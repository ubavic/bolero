eval `{bolero tool dist env -9}

if(! test -x $BOLERO_TOOLDIR/dist){
	echo 'cannot find $BOLERO_TOOLDIR/dist; nothing to clean' >[1=2]
	exit noclean
}

$BOLERO_BIN/bolero clean -i std
$BOLERO_BIN/bolero tool dist clean
$BOLERO_BIN/bolero clean -i cmd
