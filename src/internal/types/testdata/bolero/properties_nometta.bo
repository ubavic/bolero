package nometta

type Person struct {
	Name string { MaxLength: 50 }
}

// Reading with @ does not require bolero/meta.
const _ = Person::Name@MaxLength

// A field descriptor does.
var _ = Person::Name /* ERROR "must import \"bolero/meta\"" */
