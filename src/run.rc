# license that can be found in the LICENSE file.

rfork e

if(! test -f ../bin/bolero){
	echo 'run.rc must be run from $BOLERO_ROOT/src after installing cmd/go' >[1=2]
	exit wrongdir
}

BOLERO_ENV=off
eval `{../bin/bolero tool dist env}

BOLERO_PATH=/nonexist-gopath
exec ../bin/bolero tool dist test -rebuild $*
