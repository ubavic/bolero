package main

import "fmt"

type Color enum {
	Red
	Green
	Blue
}

func (c Color) String() string {
	switch c {
	case Color::Red:
		return "red"
	case Color::Green:
		return "green"
	case Color::Blue:
		return "blue"
	}
	panic("unreachable")
}

func convert[T int | int8 | uint64](x T) (c Color, err any) {
	defer func() { err = recover() }()
	return Color(x), nil
}

func show(x any, c Color, err any) {
	if err != nil {
		fmt.Println(x, err)
	} else {
		fmt.Println(x, c)
	}
}

// Size has no String method, so it gets one that returns the value names.
type Size enum {
	Small
	Large
}

func main() {
	for c := range Color {
		fmt.Println(int(c), c)
	}
	fmt.Println(Size::Large)
	fmt.Printf("%v %s %d %q\n", Size::Small, Size::Small, Size::Small, Size::Large.String())

	for _, n := range []int{0, 2, 3, -1} {
		c, err := convert(n)
		show(n, c, err)
	}
	c, err := convert(int8(-128))
	show(-128, c, err)
	c, err = convert(uint64(1 << 63))
	show(uint64(1<<63), c, err)
}
