package main

import (
	"fmt"

	"bolero/meta"
)

type Person struct {
	Name string { Required, MaxLength: 50, Label: "Full name" }
	Age  uint
} { Table: "people" }

type Status enum {
	Active   { Label: "On" }
	Archived { Label: "Off", Hidden: true }
} { Label: "Status" }

type Employee struct {
	Person
}

func main() {
	fmt.Println(Person@Table)
	fmt.Println(Person::Name@MaxLength)
	fmt.Println(Status::Archived@Hidden)
	fmt.Println(Status@Label)
	fmt.Println(Employee::Name@Label)

	p := Person{Name: "Ann", Age: 3}
	f := Person::Name
	fmt.Println(f.Name(), f.Get(p))
	f.Set(&p, "Bea")
	fmt.Println(p.Name, f == Person::Name)

	label, ok := f.Properties().Lookup("Label")
	fmt.Println(label, ok)
	table, ok := meta.TypeProperties[Person]().Lookup("Table")
	fmt.Println(table, ok)
	hidden, ok := meta.ValueProperties(Status::Archived).Lookup("Hidden")
	fmt.Println(hidden, ok)
	_, ok = meta.ValueProperties(Status::Active).Lookup("Hidden")
	fmt.Println(ok)

	e := Employee{Person: Person{Name: "Cy"}}
	fmt.Println(Employee::Name.Get(e))
	Employee::Name.Set(&e, "Di")
	fmt.Println(e.Name)

	// Label replaces the name in the generated String method.
	fmt.Println(Status::Active, Status::Archived)
}
